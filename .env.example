BROWSERBASE_API_KEY=

# Pinch Payments — sandbox only. Server-side secrets; never prefix with
# NEXT_PUBLIC_ and never read these from a client component.
PINCH_APPLICATION_ID=
PINCH_APPLICATION_SECRET=
PINCH_API_BASE_URL=https://api.getpinch.com.au/test
PINCH_TEST_MODE=true

# Optional. Defaults to the documented Pinch token endpoint.
PINCH_AUTH_URL=https://auth.getpinch.com.au/connect/token

# Absolute origin Pinch returns the founder to after checkout.
NEXT_PUBLIC_APP_URL=http://localhost:5198

# Development only. When true, Playground generates placeholder identifiers
# instead of calling Pinch, and labels every surface as mock data.
PINCH_MOCK_MODE=false
